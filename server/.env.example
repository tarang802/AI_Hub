# Copy to .env and fill in — never commit the real .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Create a free cluster at https://cloud.mongodb.com if you don't have one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-hub?retryWrites=true&w=majority

# Google OAuth client — create at https://console.cloud.google.com
#   APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application
#   Authorized redirect URI: <SERVER_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# This server's own public URL (used to build the OAuth callback URL).
SERVER_URL=http://localhost:4000

# The React app's URL — allowed for CORS + where we redirect after login/logout.
CLIENT_URL=http://localhost:5173

# Only Google accounts on this exact hosted domain are allowed to even attempt
# login (VIT's student Google Workspace domain). Accounts outside it are
# rejected before the member-allowlist check ever runs.
ALLOWED_HOSTED_DOMAIN=vitstudent.ac.in

PORT=4000
NODE_ENV=development
