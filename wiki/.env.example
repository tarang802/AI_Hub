# Copy to .env and fill in — never commit the real .env file.

# Postgres password for the wiki database. Generate a strong random value, e.g.:
#   openssl rand -base64 24
DB_PASSWORD=change-me-to-a-strong-random-password

# Port Wiki.js listens on locally / on the host (put a reverse proxy with TLS in front of this in production).
WIKI_PORT=3000
